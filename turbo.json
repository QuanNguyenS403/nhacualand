{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@batdongsan/database#build": {
      "cache": false
    },
    "@qns/shared#build": {
      "outputs": ["src/**/*.js", "src/**/*.d.ts"]
    },
    "@batdongsan/api#build": {
      "dependsOn": ["@batdongsan/database#build", "@qns/shared#build"],
      "outputs": ["dist/**"]
    },
    "@batdongsan/web#build": {
      "dependsOn": ["@qns/shared#build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/**/*.js"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
