{
  "name": "@batdongsan/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "import:listings": "dotenv -e ../../.env -- ts-node --transpile-only scripts/import-listings.ts",
    "bootstrap:admin": "dotenv -e ../../.env -- ts-node --transpile-only scripts/bootstrap-admin.ts",
    "backfill:ledgers": "dotenv -e ../../.env -- ts-node --transpile-only scripts/backfill-finance-ledgers.ts",
    "migrate:legacy": "dotenv -e ../../.env -- ts-node --transpile-only scripts/migrate-legacy-listings.ts",
    "test:wave0": "dotenv -e ../../.env -- ts-node scripts/test-wave-0.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
