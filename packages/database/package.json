{
  "name": "@batdongsan/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "node scripts/prisma-generate-safe.js",
    "generate": "node scripts/prisma-generate-safe.js",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "studio": "npx prisma studio",
    "seed": "ts-node --transpile-only -r dotenv/config prisma/seed.ts dotenv_config_path=../../.env",
    "import:listings": "ts-node --transpile-only -r dotenv/config scripts/import-listings.ts dotenv_config_path=../../.env",
    "bootstrap:admin": "ts-node --transpile-only -r dotenv/config scripts/bootstrap-admin.ts dotenv_config_path=../../.env",
    "backfill:ledgers": "ts-node --transpile-only -r dotenv/config scripts/backfill-finance-ledgers.ts dotenv_config_path=../../.env",
    "migrate:legacy": "ts-node --transpile-only -r dotenv/config scripts/migrate-legacy-listings.ts dotenv_config_path=../../.env",
    "test:wave0": "ts-node -r dotenv/config scripts/test-wave-0.ts dotenv_config_path=../../.env"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "prisma": "^5.19.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
