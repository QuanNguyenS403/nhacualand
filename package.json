{
  "name": "batdongsan-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @batdongsan/web dev",
    "dev:api": "pnpm --filter @batdongsan/api dev",
    "build": "turbo run build",
    "start": "node scripts/start-all.js",
    "lint": "node packages/database/scripts/static-lint-check.js",
    "audit:data": "node scripts/audit-data.js",
    "test:e2e": "node scripts/e2e-map-sync-test.js",
    "test:static-lint": "node packages/database/scripts/static-lint-check.js",
    "db:check": "node scripts/kiem-tra-supabase.js",
    "db:generate": "pnpm --filter @batdongsan/database generate",
    "db:migrate": "pnpm --filter @batdongsan/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @batdongsan/database migrate:deploy",
    "db:seed": "pnpm --filter @batdongsan/database seed",
    "db:studio": "pnpm --filter @batdongsan/database studio",
    "db:import-listings": "pnpm --filter @batdongsan/database import:listings --",
    "db:bootstrap-admin": "pnpm --filter @batdongsan/database bootstrap:admin",
    "test:wave0": "node packages/database/scripts/test-wave-0.js",
    "test:wave1": "node packages/database/scripts/test-wave-1.js",
    "test:wave2": "node packages/database/scripts/test-wave-2.js",
    "test:wave3": "node packages/database/scripts/test-wave-3.js"
  },
  "devDependencies": {
    "prisma": "^5.19.1",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  }
}
