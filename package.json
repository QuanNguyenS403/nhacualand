{
  "name": "batdongsan-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@batdongsan/web",
    "dev:api": "npm run dev --workspace=@batdongsan/api",
    "build": "turbo run build",
    "lint": "node packages/database/scripts/static-lint-check.js",
    "audit:data": "node scripts/audit-data.js",
    "test:e2e": "node scripts/e2e-map-sync-test.js",
    "test:static-lint": "node packages/database/scripts/static-lint-check.js",
    "db:generate": "npm run generate --workspace=@batdongsan/database",
    "db:migrate": "npm run migrate:dev --workspace=@batdongsan/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@batdongsan/database",
    "db:seed": "npm run seed --workspace=@batdongsan/database",
    "db:studio": "npm run studio --workspace=@batdongsan/database",
    "db:import-listings": "npm run import:listings --workspace=@batdongsan/database --",
    "db:bootstrap-admin": "npm run bootstrap:admin --workspace=@batdongsan/database",
    "test:wave0": "node packages/database/scripts/test-wave-0.js",
    "test:wave1": "node packages/database/scripts/test-wave-1.js",
    "test:wave2": "node packages/database/scripts/test-wave-2.js",
    "test:wave3": "node packages/database/scripts/test-wave-3.js"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  }
}
